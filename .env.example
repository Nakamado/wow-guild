# ─────────────────────────────────────────────────────────────────────────────
# Miinyu WoW Forever – Umgebungsvariablen
# Kopieren nach `.env` und ausfüllen. `.env` wird NIE committet.
#
# Die Seite startet komplett OHNE diese Werte im Demo-Modus.
# Variablen ohne NUXT_PUBLIC_-Präfix existieren nur auf dem Server.
# Fehlt ein Zugangsdatum, fällt nur der betroffene Provider auf Demo zurück.
# ─────────────────────────────────────────────────────────────────────────────

# ── Allgemein ────────────────────────────────────────────────────────────────
# Öffentliche Basis-URL (OAuth-Redirects, Open Graph, Twitch-Embed-`parent`)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# Live: https://www.mukimuki-forever.de (mit www, ohne / am Ende) – daraus entstehen Canonical-URLs, Sitemap und OAuth-Redirects
# Kontaktadresse für Impressum/Datenschutz (Standard: kontakt@mukimuki-forever.de)
# NUXT_PUBLIC_CONTACT_EMAIL=
# true = fiktive Demo-Daten und Demo-Rollenauswahl, false = Live-Provider
NUXT_PUBLIC_DEMO_MODE=true

# Mind. 32 Zeichen, zufällig – versiegelt die Login-Session-Cookies (Pflicht im Live-Betrieb).
# Lokal erzeugt Nuxt den Wert automatisch – dann die Zeile auskommentiert lassen (leer = Fehler).
# Erzeugen z. B. mit: openssl rand -base64 32
# NUXT_APP_SECRET=

# ── Gilde (öffentlich, konfigurierbar) ───────────────────────────────────────
NUXT_PUBLIC_GUILD_NAME=MukiMuki
# Regelsatz der Gilde (WoW: Forever hat keine Realms): PvE, PvP, RP …
NUXT_PUBLIC_GUILD_REALM=PvE
# alliance | horde
NUXT_PUBLIC_GUILD_FACTION=alliance
NUXT_PUBLIC_GUILD_DISCORD_INVITE=https://discord.gg/tWnAgUK

# ── Discord OAuth2 (https://discord.com/developers/applications) ─────────────
# Redirect-URL in der Discord-App: <SITE_URL>/auth/discord
NUXT_DISCORD_CLIENT_ID=
NUXT_DISCORD_CLIENT_SECRET=

# ── Discord Server & Rollen ──────────────────────────────────────────────────
NUXT_DISCORD_GUILD_ID=723275162971275335
# Rolle „WoW Forever“ = Gildenmitglied
NUXT_DISCORD_MEMBER_ROLE_ID=
# Admin- bzw. Event-Moderator-Rolle (mehrere Rollen kommagetrennt, z. B. Admin und MOD)
NUXT_DISCORD_ADMIN_ROLE_ID=
# Rolle „Streamer“: Mitglieder mit dieser Rolle können in den Einstellungen ihren Twitch-Kanal eintragen
# und erscheinen dann unter Streamer und Clips
NUXT_DISCORD_STREAMER_ROLE_ID=
# Discord-User-IDs (kommagetrennt), die auf der Seite immer Admin sind – unabhängig von Rollen
# (z. B. Betreiber der Webseite). Discord: Entwicklermodus → Rechtsklick auf Namen → „Nutzer-ID kopieren“
NUXT_ADMIN_USER_IDS=

# ── Discord Bot (Mitgliederliste, Scheduled Events) ─────────────────────────
# Benötigt den privilegierten „Server Members Intent“ (Anleitung im README)
NUXT_DISCORD_BOT_TOKEN=

# ── Twitch Helix (https://dev.twitch.tv/console/apps) ───────────────────────
NUXT_TWITCH_CLIENT_ID=
NUXT_TWITCH_CLIENT_SECRET=
NUXT_PUBLIC_TWITCH_CHANNEL=miinyu
NUXT_PUBLIC_TWITCH_BROADCASTER_ID=114422810

# ── Blizzard Battle.net (https://community.developer.battle.net/access/clients) ──────
# Redirect-URL im Client: <SITE_URL>/auth/battlenet – vorerst nur für die API-Probe der Gildenleitung
NUXT_BLIZZARD_CLIENT_ID=
NUXT_BLIZZARD_CLIENT_SECRET=
NUXT_BLIZZARD_REGION=eu
# Gilde in der Blizzard-API (Slug aus der Gildenliste, z. B. gildenname); noch offen
NUXT_BLIZZARD_GUILD_SLUG=
# Testlauf Rangliste (nur mit Einverständnis!): Charaktere kommagetrennt, optional mit Discord-ID des Besitzers,
# z. B. "Nak Totembart=591736149647687697" – dann erscheinen Discord-Name und -Profilbild
NUXT_BLIZZARD_PREVIEW_CHARACTERS=

# ── Supabase (nur serverseitig, Service-Role-Key NIE im Client) ──────────────
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_ROLE_KEY=
